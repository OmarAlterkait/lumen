<?xml version="1.0" encoding="UTF-8"?>
<!-- demo_barrel: the example detector of lumen's "your own detector" guide. A water cylinder (radius 0.6 m, height
     1.2 m) lined with a black sheet, inside a 1 cm plastic barrel, with 12 disc PMTs (4 on the top, 4 on the bottom,
     4 on the side). It is written with two deliberate exporter defects, so the guide can show how lumen repairs and
     reports them:
       1. WATER_ABSLENGTH has one value too many (an unpaired tail: Geant4 refuses the file);
       2. the liner's REFLECTIVITY is a one-column constant (Geant4 loads it, but its boundary process reads only
          tables, so the sheet reflects at Geant4's default of 1).
     Written for the lumen documentation; Apache-2.0 like the rest of the repository. -->
<gdml>
<define>
  <matrix name="WATER_RINDEX" coldim="2" values="1.5*eV 1.332 2.5*eV 1.336 3.5*eV 1.345 5.0*eV 1.366"/>
  <matrix name="WATER_ABSLENGTH" coldim="2" values="1.5*eV 5.0*m 2.5*eV 40.0*m 3.0*eV 60.0*m 3.5*eV 30.0*m 5.0*eV 2.0*m 7.0*eV"/>
  <matrix name="LINER_REFLECTIVITY" coldim="1" values="0.1"/>
  <matrix name="CATHODE_REFLECTIVITY" coldim="2" values="1.5*eV 0.0 5.0*eV 0.0"/>
  <matrix name="CATHODE_EFFICIENCY" coldim="2" values="1.5*eV 1.0 5.0*eV 1.0"/>
</define>
<materials>
  <element name="Hydrogen" formula="H" Z="1"><atom value="1.008"/></element>
  <element name="Carbon" formula="C" Z="6"><atom value="12.011"/></element>
  <element name="Oxygen" formula="O" Z="8"><atom value="15.999"/></element>
  <element name="Nitrogen" formula="N" Z="7"><atom value="14.007"/></element>
  <material name="Water" state="liquid">
    <D value="1.0" unit="g/cm3"/>
    <composite n="2" ref="Hydrogen"/><composite n="1" ref="Oxygen"/>
    <property name="RINDEX" ref="WATER_RINDEX"/>
    <property name="ABSLENGTH" ref="WATER_ABSLENGTH"/>
  </material>
  <material name="Polyethylene" state="solid">
    <D value="0.94" unit="g/cm3"/>
    <composite n="1" ref="Carbon"/><composite n="2" ref="Hydrogen"/>
  </material>
  <material name="Air" state="gas">
    <D value="0.0012" unit="g/cm3"/>
    <fraction n="1.0" ref="Nitrogen"/>
  </material>
  <material name="Bialkali" state="solid">
    <D value="2.2" unit="g/cm3"/>
    <fraction n="1.0" ref="Oxygen"/>
  </material>
</materials>
<solids>
  <box name="WorldBox" x="3000" y="3000" z="3000" lunit="mm"/>
  <tube name="BarrelTube" rmin="0" rmax="610" z="1220" startphi="0" deltaphi="360" aunit="deg" lunit="mm"/>
  <tube name="WaterTube" rmin="0" rmax="600" z="1200" startphi="0" deltaphi="360" aunit="deg" lunit="mm"/>
  <tube name="PMTDisc" rmin="0" rmax="50" z="20" startphi="0" deltaphi="360" aunit="deg" lunit="mm"/>
  <opticalsurface name="LinerSurface" model="unified" finish="groundfrontpainted" type="dielectric_dielectric" value="1">
    <property name="REFLECTIVITY" ref="LINER_REFLECTIVITY"/>
  </opticalsurface>
  <opticalsurface name="PhotocathodeSurface" model="unified" finish="polished" type="dielectric_metal" value="0">
    <property name="REFLECTIVITY" ref="CATHODE_REFLECTIVITY"/>
    <property name="EFFICIENCY" ref="CATHODE_EFFICIENCY"/>
  </opticalsurface>
</solids>
<structure>
  <volume name="PMT">
    <materialref ref="Bialkali"/>
    <solidref ref="PMTDisc"/>
  </volume>
  <volume name="WaterLV">
    <materialref ref="Water"/>
    <solidref ref="WaterTube"/>
    <physvol name="PMT_top_0" copynumber="0">
      <volumeref ref="PMT"/>
      <position name="PMT_top_0_pos" x="212.132" y="212.132" z="580" unit="mm"/>
    </physvol>
    <physvol name="PMT_bottom_0" copynumber="1">
      <volumeref ref="PMT"/>
      <position name="PMT_bottom_0_pos" x="212.132" y="212.132" z="-580" unit="mm"/>
    </physvol>
    <physvol name="PMT_top_1" copynumber="2">
      <volumeref ref="PMT"/>
      <position name="PMT_top_1_pos" x="-212.132" y="212.132" z="580" unit="mm"/>
    </physvol>
    <physvol name="PMT_bottom_1" copynumber="3">
      <volumeref ref="PMT"/>
      <position name="PMT_bottom_1_pos" x="-212.132" y="212.132" z="-580" unit="mm"/>
    </physvol>
    <physvol name="PMT_top_2" copynumber="4">
      <volumeref ref="PMT"/>
      <position name="PMT_top_2_pos" x="-212.132" y="-212.132" z="580" unit="mm"/>
    </physvol>
    <physvol name="PMT_bottom_2" copynumber="5">
      <volumeref ref="PMT"/>
      <position name="PMT_bottom_2_pos" x="-212.132" y="-212.132" z="-580" unit="mm"/>
    </physvol>
    <physvol name="PMT_top_3" copynumber="6">
      <volumeref ref="PMT"/>
      <position name="PMT_top_3_pos" x="212.132" y="-212.132" z="580" unit="mm"/>
    </physvol>
    <physvol name="PMT_bottom_3" copynumber="7">
      <volumeref ref="PMT"/>
      <position name="PMT_bottom_3_pos" x="212.132" y="-212.132" z="-580" unit="mm"/>
    </physvol>
    <physvol name="PMT_side_0" copynumber="8">
      <volumeref ref="PMT"/>
      <position name="PMT_side_0_pos" x="580" y="0" z="0" unit="mm"/>
      <rotation name="PMT_side_0_rot" x="0" y="90" z="0" unit="deg"/>
    </physvol>
    <physvol name="PMT_side_1" copynumber="9">
      <volumeref ref="PMT"/>
      <position name="PMT_side_1_pos" x="0" y="580" z="0" unit="mm"/>
      <rotation name="PMT_side_1_rot" x="90" y="0" z="0" unit="deg"/>
    </physvol>
    <physvol name="PMT_side_2" copynumber="10">
      <volumeref ref="PMT"/>
      <position name="PMT_side_2_pos" x="-580" y="0" z="0" unit="mm"/>
      <rotation name="PMT_side_2_rot" x="0" y="90" z="0" unit="deg"/>
    </physvol>
    <physvol name="PMT_side_3" copynumber="11">
      <volumeref ref="PMT"/>
      <position name="PMT_side_3_pos" x="0" y="-580" z="0" unit="mm"/>
      <rotation name="PMT_side_3_rot" x="90" y="0" z="0" unit="deg"/>
    </physvol>
  </volume>
  <volume name="BarrelLV">
    <materialref ref="Polyethylene"/>
    <solidref ref="BarrelTube"/>
    <physvol name="WaterPV">
      <volumeref ref="WaterLV"/>
    </physvol>
  </volume>
  <volume name="World">
    <materialref ref="Air"/>
    <solidref ref="WorldBox"/>
    <physvol name="BarrelPV">
      <volumeref ref="BarrelLV"/>
    </physvol>
  </volume>
  <skinsurface name="Liner" surfaceproperty="LinerSurface">
    <volumeref ref="WaterLV"/>
  </skinsurface>
  <bordersurface name="Photocathode_PMT_top_0" surfaceproperty="PhotocathodeSurface">
    <physvolref ref="WaterPV"/>
    <physvolref ref="PMT_top_0"/>
  </bordersurface>
  <bordersurface name="Photocathode_PMT_bottom_0" surfaceproperty="PhotocathodeSurface">
    <physvolref ref="WaterPV"/>
    <physvolref ref="PMT_bottom_0"/>
  </bordersurface>
  <bordersurface name="Photocathode_PMT_top_1" surfaceproperty="PhotocathodeSurface">
    <physvolref ref="WaterPV"/>
    <physvolref ref="PMT_top_1"/>
  </bordersurface>
  <bordersurface name="Photocathode_PMT_bottom_1" surfaceproperty="PhotocathodeSurface">
    <physvolref ref="WaterPV"/>
    <physvolref ref="PMT_bottom_1"/>
  </bordersurface>
  <bordersurface name="Photocathode_PMT_top_2" surfaceproperty="PhotocathodeSurface">
    <physvolref ref="WaterPV"/>
    <physvolref ref="PMT_top_2"/>
  </bordersurface>
  <bordersurface name="Photocathode_PMT_bottom_2" surfaceproperty="PhotocathodeSurface">
    <physvolref ref="WaterPV"/>
    <physvolref ref="PMT_bottom_2"/>
  </bordersurface>
  <bordersurface name="Photocathode_PMT_top_3" surfaceproperty="PhotocathodeSurface">
    <physvolref ref="WaterPV"/>
    <physvolref ref="PMT_top_3"/>
  </bordersurface>
  <bordersurface name="Photocathode_PMT_bottom_3" surfaceproperty="PhotocathodeSurface">
    <physvolref ref="WaterPV"/>
    <physvolref ref="PMT_bottom_3"/>
  </bordersurface>
  <bordersurface name="Photocathode_PMT_side_0" surfaceproperty="PhotocathodeSurface">
    <physvolref ref="WaterPV"/>
    <physvolref ref="PMT_side_0"/>
  </bordersurface>
  <bordersurface name="Photocathode_PMT_side_1" surfaceproperty="PhotocathodeSurface">
    <physvolref ref="WaterPV"/>
    <physvolref ref="PMT_side_1"/>
  </bordersurface>
  <bordersurface name="Photocathode_PMT_side_2" surfaceproperty="PhotocathodeSurface">
    <physvolref ref="WaterPV"/>
    <physvolref ref="PMT_side_2"/>
  </bordersurface>
  <bordersurface name="Photocathode_PMT_side_3" surfaceproperty="PhotocathodeSurface">
    <physvolref ref="WaterPV"/>
    <physvolref ref="PMT_side_3"/>
  </bordersurface>
</structure>
<setup name="Default" version="1.0">
  <world ref="World"/>
</setup>
</gdml>
