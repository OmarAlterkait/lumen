<?xml version="1.0" encoding="UTF-8"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
 <define><matrix name="RIX1" coldim="2" values="1.5*eV 1.0 4.0*eV 1.0"/><matrix name="RIX15" coldim="2" values="1.5*eV 1.5 4.0*eV 1.5"/><matrix name="RIX2" coldim="2" values="1.5*eV 2.0 4.0*eV 2.0"/></define>
 <materials>
  <element name="H" formula="H" Z="1"><atom value="1.008"/></element>
  <material name="Vac"><D value="1e-6" unit="g/cm3"/><fraction n="1" ref="H"/><property name="RINDEX" ref="RIX1"/></material>
  <material name="Vac2"><D value="2e-6" unit="g/cm3"/><fraction n="1" ref="H"/><property name="RINDEX" ref="RIX1"/></material>
  <material name="Vac3"><D value="3e-6" unit="g/cm3"/><fraction n="1" ref="H"/><property name="RINDEX" ref="RIX1"/></material>
  <material name="Gls"><D value="2.2" unit="g/cm3"/><fraction n="1" ref="H"/><property name="RINDEX" ref="RIX15"/></material>
  <material name="Dia"><D value="3.5" unit="g/cm3"/><fraction n="1" ref="H"/><property name="RINDEX" ref="RIX2"/></material>
 </materials>
 <solids>
  <box name="sWorld" x="4000" y="4000" z="4000" lunit="mm"/>
  <box name="s400" x="400" y="400" z="400" lunit="mm"/>
  <box name="s200" x="200" y="200" z="200" lunit="mm"/>
  <box name="sF" x="100" y="100" z="100" lunit="mm"/>
  <box name="sS" x="100" y="1000" z="1000" lunit="mm"/>
 </solids>
 <structure>
  <volume name="volF"><materialref ref="Vac"/><solidref ref="sF"/></volume>
  <volume name="volS"><materialref ref="Vac"/><solidref ref="sS"/></volume>
  <volume name="volA"><materialref ref="Vac2"/><solidref ref="s400"/></volume>
  <volume name="volB"><materialref ref="Gls"/><solidref ref="s400"/></volume>
  <volume name="volC"><materialref ref="Dia"/><solidref ref="s400"/></volume>
  <volume name="volWorld"><materialref ref="Vac"/><solidref ref="sWorld"/>
   <physvol name="pF0"><volumeref ref="volF"/><position name="pF0p" x="0" y="1500" z="0" unit="mm"/></physvol>
   <physvol name="pF1"><volumeref ref="volF"/><position name="pF1p" x="0" y="-1500" z="0" unit="mm"/></physvol>
   <physvol name="pA"><volumeref ref="volA"/><position name="pAp" x="0" y="0" z="0" unit="mm"/></physvol>
   <physvol name="pB"><volumeref ref="volB"/><position name="pBp" x="100" y="0" z="0" unit="mm"/></physvol>
   <physvol name="pC"><volumeref ref="volC"/><position name="pCp" x="150" y="0" z="0" unit="mm"/></physvol>
   <physvol name="pF2"><volumeref ref="volF"/><position name="pF2p" x="0" y="0" z="1500" unit="mm"/></physvol>
   <physvol name="pF3"><volumeref ref="volF"/><position name="pF3p" x="0" y="0" z="-1500" unit="mm"/></physvol>
   <physvol name="pS"><volumeref ref="volS"/><position name="pSp" x="800" y="0" z="0" unit="mm"/></physvol>
  </volume>
 </structure>
 <setup name="Default" version="1.0"><world ref="volWorld"/></setup>
</gdml>
